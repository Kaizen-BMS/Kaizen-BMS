# Copy to .env and fill in. Never commit .env (it is gitignored).

# ── Database ─────────────────────────────────────────────────────────
# There is one database for this project — the real Hostinger DB. See
# CLAUDE.md "Database rule": nothing in this repo ever applies a schema
# change here; migrations are handed off as files for the owner to run.
#
# Connecting from a machine that is NOT Hostinger itself (e.g. local dev) —
# use Hostinger's Remote MySQL hostname, not "localhost":
DB_HOST=srv1872.hstgr.io
DB_PORT=3306
DB_USER=u111637957_kaizen
DB_PASSWORD=your_database_password
DB_NAME=u111637957_kaizen
# Same connection, Prisma's format (used by prisma/schema.prisma and
# src/lib/prismaClient.js). URL-encode special characters in the password
# (e.g. & becomes %26).
DATABASE_URL="mysql://u111637957_kaizen:your_database_password@srv1872.hstgr.io:3306/u111637957_kaizen"
#
# Prerequisite on the Hostinger side: hPanel -> Databases -> Remote MySQL ->
# enable Remote MySQL for this database + whitelist the connecting
# machine's IP.
#
# If the Node app is ever deployed to run ON Hostinger itself, that
# deployment's own env vars can use DB_HOST=localhost instead (no Remote
# MySQL needed there — it's a property of where the app is running, not a
# fixed value for the project).

# ── Auth ─────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ── Patient OTP email (Gmail SMTP via nodemailer) ───────────────────
# EMAIL_APP_PASSWORD must be a Gmail App Password (16 chars, from Google
# Account -> Security -> 2-Step Verification -> App Passwords), NOT the
# regular Gmail login password — Gmail rejects plain-password SMTP auth
# entirely. Requires 2-Step Verification enabled on that Gmail account
# first. See src/lib/mailer.js.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-16-char-gmail-app-password

# ── External integration credential encryption ──────────────────────
# AES-256-GCM key for encrypting external provider secrets at rest
# (external_credentials.encrypted_secret — see src/lib/crypto.js). Must be
# exactly 32 bytes; generate as base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing/rotating this key makes every already-stored credential
# undecryptable — back it up like a real secret, not like JWT_SECRET
# (which only invalidates sessions on rotation, not stored data).
EXTERNAL_INTEGRATION_KEY=replace-with-a-32-byte-base64-key

# ── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
