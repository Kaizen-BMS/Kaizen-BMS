# Copy to .env and fill in. Never commit .env (it is gitignored).

# ── Database ─────────────────────────────────────────────────────────
# Local dev: any local MySQL / MariaDB.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Production (app.kaizenbms.in). This is a Node custom server (server.js), so
# it must run on Hostinger's Node.js hosting / VPS — not PHP shared hosting.
# DB_USER / DB_NAME are the prefixed names (e.g. u111637957_kaizen).
#
# DEPLOYMENT MODEL: the Node app and the MySQL DB live on the SAME Hostinger
# account/server, so:
#   DB_HOST=localhost
#   DB_PORT=3306
# No Remote MySQL setup, no IP whitelist — it connects locally.
#
# (Only if the app is ever moved off Hostinger: switch DB_HOST to the remote
#  hostname from hPanel -> Databases -> Remote MySQL, and there enable Remote
#  MySQL + whitelist the app server's IP.)

# ── Auth ─────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
