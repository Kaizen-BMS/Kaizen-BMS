generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admissions {
  id              BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id       BigInt                     @db.UnsignedBigInt
  visit_id        BigInt                     @db.UnsignedBigInt
  bed_id          BigInt                     @db.UnsignedBigInt
  admitted_by     BigInt?                    @db.UnsignedBigInt
  admitted_at     DateTime                   @default(now())
  discharged_at   DateTime?
  discharge_type  admissions_discharge_type?
  discharge_notes String?                    @db.VarChar(2000)
  users           users?                     @relation(fields: [admitted_by], references: [id], onUpdate: Restrict, map: "fk_admissions_admitted_by")
  beds            beds                       @relation(fields: [bed_id], references: [id], onUpdate: Restrict, map: "fk_admissions_bed")
  tenants         tenants                    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_admissions_tenant")
  visits          visits                     @relation(fields: [visit_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_admissions_visit")
  bed_transfers   bed_transfers[]
  consent_forms   consent_forms[]
  nursing_notes   nursing_notes[]

  @@index([admitted_by], map: "fk_admissions_admitted_by")
  @@index([visit_id], map: "fk_admissions_visit")
  @@index([bed_id], map: "idx_admissions_bed")
  @@index([tenant_id], map: "idx_admissions_tenant")
  @@index([tenant_id, visit_id], map: "idx_admissions_tenant_visit")
}

model beds {
  id                                            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id                                     BigInt          @db.UnsignedBigInt
  ward_type                                     String          @db.VarChar(30)
  bed_number                                    String          @db.VarChar(50)
  daily_rate                                    Decimal         @default(0.00) @db.Decimal(10, 2)
  service_id                                    BigInt?         @db.UnsignedBigInt
  status                                        beds_status     @default(VACANT)
  maintenance_reason                            String?         @db.VarChar(255)
  maintenance_until                             DateTime?       @db.Date
  created_at                                    DateTime        @default(now())
  admissions                                    admissions[]
  bed_transfers_bed_transfers_from_bed_idTobeds bed_transfers[] @relation("bed_transfers_from_bed_idTobeds")
  bed_transfers_bed_transfers_to_bed_idTobeds   bed_transfers[] @relation("bed_transfers_to_bed_idTobeds")
  services                                      services?       @relation(fields: [service_id], references: [id], onUpdate: Restrict, map: "fk_beds_service")
  tenants                                       tenants         @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_beds_tenant")

  @@unique([tenant_id, ward_type, bed_number], map: "uq_beds_tenant_ward_number")
  @@index([tenant_id], map: "idx_beds_tenant")
  @@index([tenant_id, status], map: "idx_beds_tenant_status")
  @@index([service_id], map: "idx_beds_service")
}

model bill_items {
  id             BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  bill_id        BigInt            @db.UnsignedBigInt
  source         bill_items_source
  description    String            @db.VarChar(500)
  amount         Decimal           @default(0.00) @db.Decimal(12, 2)
  reference_type String?           @db.VarChar(50)
  reference_id   BigInt?           @db.UnsignedBigInt
  service_id     BigInt?           @db.UnsignedBigInt
  tariff_id      BigInt?           @db.UnsignedBigInt
  quantity       Decimal           @default(1.00) @db.Decimal(10, 2)
  unit_price     Decimal?          @db.Decimal(12, 2)
  taxable_amount Decimal?          @db.Decimal(12, 2)
  tax_rate       Decimal?          @db.Decimal(5, 2)
  cgst_amount    Decimal?          @db.Decimal(12, 2)
  sgst_amount    Decimal?          @db.Decimal(12, 2)
  igst_amount    Decimal?          @db.Decimal(12, 2)
  tax_amount     Decimal?          @db.Decimal(12, 2)
  created_at     DateTime          @default(now())
  stock_id       BigInt?           @db.UnsignedBigInt
  medicine_id    BigInt?           @db.UnsignedBigInt
  batch_number   String?           @db.VarChar(80)
  expiry_date    DateTime?         @db.Date
  mrp            Decimal?          @db.Decimal(12, 2)
  purchase_rate  Decimal?          @db.Decimal(12, 2)
  bills          bills             @relation(fields: [bill_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_bill_items_bill")
  services       services?         @relation(fields: [service_id], references: [id], onUpdate: Restrict, map: "fk_bill_items_service")
  tariffs        tariffs?          @relation(fields: [tariff_id], references: [id], onUpdate: Restrict, map: "fk_bill_items_tariff")

  @@index([bill_id], map: "idx_bill_items_bill")
  @@index([reference_type, reference_id], map: "idx_bill_items_reference")
  @@index([service_id], map: "idx_bill_items_service")
  @@index([tariff_id], map: "idx_bill_items_tariff")
}

model bills {
  id           BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id    BigInt          @db.UnsignedBigInt
  patient_id   BigInt          @db.UnsignedBigInt
  visit_id     BigInt?         @db.UnsignedBigInt
  bill_type    bills_bill_type
  total_amount Decimal         @default(0.00) @db.Decimal(12, 2)
  status       bills_status    @default(OPEN)
  created_by   BigInt?         @db.UnsignedBigInt
  created_at   DateTime        @default(now())
  finalized_at DateTime?
  bill_items   bill_items[]
  users        users?          @relation(fields: [created_by], references: [id], onUpdate: Restrict, map: "fk_bills_created_by")
  patients     patients        @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_bills_patient")
  tenants      tenants         @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_bills_tenant")
  visits       visits?         @relation(fields: [visit_id], references: [id], onUpdate: Restrict, map: "fk_bills_visit")
  discounts    discounts[]
  payments     payments[]
  refunds      refunds[]

  @@index([tenant_id], map: "idx_bills_hospital")
  @@index([patient_id], map: "idx_bills_patient")
  @@index([created_by], map: "fk_bills_created_by")
  @@index([tenant_id, status], map: "idx_bills_tenant_status")
  @@index([visit_id], map: "idx_bills_visit")
}

model consent_forms {
  id           BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id    BigInt     @db.UnsignedBigInt
  admission_id BigInt     @db.UnsignedBigInt
  form_type    String     @db.VarChar(100)
  signed_at    DateTime   @default(now())
  file_url     String?    @db.VarChar(500)
  recorded_by  BigInt?    @db.UnsignedBigInt
  admissions   admissions @relation(fields: [admission_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_consent_forms_admission")
  users        users?     @relation(fields: [recorded_by], references: [id], onUpdate: Restrict, map: "fk_consent_forms_recorded_by")
  tenants      tenants    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_consent_forms_tenant")

  @@index([recorded_by], map: "fk_consent_forms_recorded_by")
  @@index([admission_id], map: "idx_consent_forms_admission")
  @@index([tenant_id], map: "idx_consent_forms_tenant")
}

model consultations {
  id               BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id        BigInt                   @db.UnsignedBigInt
  visit_id         BigInt?                  @db.UnsignedBigInt
  patient_id       BigInt                   @db.UnsignedBigInt
  doctor_id        BigInt                   @db.UnsignedBigInt
  notes            String?                  @db.Text
  diagnosis        String?                  @db.VarChar(500)
  fee              Decimal                  @default(0.00) @db.Decimal(10, 2)
  service_id       BigInt?                  @db.UnsignedBigInt
  tariff_id        BigInt?                  @db.UnsignedBigInt
  unit_price       Decimal?                 @db.Decimal(12, 2)
  taxable_amount   Decimal?                 @db.Decimal(12, 2)
  tax_rate         Decimal?                 @db.Decimal(5, 2)
  cgst_amount      Decimal?                 @db.Decimal(12, 2)
  sgst_amount      Decimal?                 @db.Decimal(12, 2)
  igst_amount      Decimal?                 @db.Decimal(12, 2)
  tax_amount       Decimal?                 @db.Decimal(12, 2)
  fee_source       consultations_fee_source @default(MANUAL)
  custom_fields    String?                  @db.LongText
  created_at       DateTime                 @default(now())
  users            users                    @relation(fields: [doctor_id], references: [id], onUpdate: Restrict, map: "fk_consultations_doctor")
  patients         patients                 @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_consultations_patient")
  services         services?                @relation(fields: [service_id], references: [id], onUpdate: Restrict, map: "fk_consultations_service")
  tariffs          tariffs?                 @relation(fields: [tariff_id], references: [id], onUpdate: Restrict, map: "fk_consultations_tariff")
  tenants          tenants                  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_consultations_tenant")
  visits           visits?                  @relation(fields: [visit_id], references: [id], onUpdate: Restrict, map: "fk_consultations_visit")
  lab_orders       lab_orders[]
  prescriptions    prescriptions[]
  radiology_orders radiology_orders[]

  @@index([doctor_id], map: "idx_consultations_doctor")
  @@index([tenant_id], map: "idx_consultations_hospital")
  @@index([patient_id], map: "idx_consultations_patient")
  @@index([visit_id], map: "idx_consultations_visit")
  @@index([service_id], map: "idx_consultations_service")
  @@index([tariff_id], map: "idx_consultations_tariff")
}

model follow_ups {
  id             BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id      BigInt            @db.UnsignedBigInt
  patient_id     BigInt            @db.UnsignedBigInt
  visit_id       BigInt?           @db.UnsignedBigInt
  scheduled_date DateTime          @db.Date
  reason         String?           @db.VarChar(500)
  status         follow_ups_status @default(SCHEDULED)
  created_by     BigInt?           @db.UnsignedBigInt
  created_at     DateTime          @default(now())
  patients       patients          @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_follow_ups_patient")
  tenants        tenants           @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_follow_ups_tenant")
  visits         visits?           @relation(fields: [visit_id], references: [id], onUpdate: Restrict, map: "fk_follow_ups_visit")

  @@index([visit_id], map: "fk_follow_ups_visit")
  @@index([tenant_id], map: "idx_follow_ups_hospital")
  @@index([tenant_id, scheduled_date], map: "idx_follow_ups_hospital_date")
  @@index([patient_id], map: "idx_follow_ups_patient")
}

model form_templates {
  id         BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id  BigInt                   @db.UnsignedBigInt
  form_type  form_templates_form_type
  fields     String                   @db.LongText
  updated_at DateTime                 @default(now())
  tenants    tenants                  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_form_templates_tenant")

  @@unique([tenant_id, form_type], map: "uq_form_templates_hospital_type")
  @@index([tenant_id], map: "idx_form_templates_hospital")
}

model lab_orders {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id       BigInt            @db.UnsignedBigInt
  visit_id        BigInt?           @db.UnsignedBigInt
  consultation_id BigInt?           @db.UnsignedBigInt
  patient_id      BigInt            @db.UnsignedBigInt
  tests           String            @db.LongText
  custom_fields   String?           @db.LongText
  status          lab_orders_status @default(ORDERED)
  results         String?           @db.LongText
  ordered_by      BigInt?           @db.UnsignedBigInt
  collected_at    DateTime?
  received_at     DateTime?
  resulted_by     BigInt?           @db.UnsignedBigInt
  created_at      DateTime          @default(now())
  resulted_at     DateTime?
  source          String            @default("DOCTOR") @db.VarChar(16)
  referred_by     String?
  bill_id         BigInt?           @db.UnsignedBigInt
  lab_order_items lab_order_items[]
  consultations   consultations?    @relation(fields: [consultation_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_lab_orders_consultation")
  patients        patients          @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_lab_orders_patient")
  tenants         tenants           @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_lab_orders_tenant")
  visits          visits?           @relation(fields: [visit_id], references: [id], onUpdate: Restrict, map: "fk_lab_orders_visit")

  @@index([consultation_id], map: "idx_lab_orders_consultation")
  @@index([tenant_id], map: "idx_lab_orders_hospital")
  @@index([tenant_id, status], map: "idx_lab_orders_hospital_status")
  @@index([patient_id], map: "idx_lab_orders_patient")
  @@index([visit_id], map: "idx_lab_orders_visit")
}

model nursing_notes {
  id             BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id      BigInt     @db.UnsignedBigInt
  admission_id   BigInt     @db.UnsignedBigInt
  author_user_id BigInt     @db.UnsignedBigInt
  note           String?    @db.VarChar(4000)
  vitals         String?    @db.LongText
  created_at     DateTime   @default(now())
  admissions     admissions @relation(fields: [admission_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_nursing_notes_admission")
  users          users      @relation(fields: [author_user_id], references: [id], onUpdate: Restrict, map: "fk_nursing_notes_author")
  tenants        tenants    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_nursing_notes_tenant")

  @@index([author_user_id], map: "fk_nursing_notes_author")
  @@index([admission_id], map: "idx_nursing_notes_admission")
  @@index([tenant_id], map: "idx_nursing_notes_tenant")
}

model patients {
  id                 BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id          BigInt             @db.UnsignedBigInt
  name               String
  age                Int?               @db.UnsignedSmallInt
  gender             patients_gender?
  phone              String?            @db.VarChar(32)
  email              String?
  otp_code_hash      String?            @db.VarChar(255)
  otp_expires_at     DateTime?
  otp_requested_at   DateTime?
  otp_attempts       Int                @default(0) @db.UnsignedTinyInt
  custom_fields      String?            @db.LongText
  allergies          String?            @db.LongText
  abha_id            String?            @db.VarChar(64)
  referral_source_id BigInt?            @db.UnsignedBigInt
  created_at         DateTime           @default(now())
  appointments       appointments[]
  bills              bills[]
  consultations      consultations[]
  feedback           feedback[]
  follow_ups         follow_ups[]
  lab_orders         lab_orders[]
  patient_insurance  patient_insurance?
  referral_sources   referral_sources?  @relation(fields: [referral_source_id], references: [id], onUpdate: Restrict, map: "fk_patients_referral_source")
  tenants            tenants            @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_patients_tenant")
  radiology_orders   radiology_orders[]
  visits             visits[]

  @@index([tenant_id], map: "idx_patients_hospital")
  @@index([tenant_id, created_at], map: "idx_patients_hospital_created")
  @@index([referral_source_id], map: "idx_patients_referral_source")
}

model pharmacy_stock {
  id                       BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id                BigInt                     @db.UnsignedBigInt
  module_instance_id       BigInt?                    @db.UnsignedBigInt
  medicine_id              BigInt?                    @db.UnsignedBigInt
  medicine_name            String
  batch_number             String?
  expiry_date              DateTime?                  @db.Date
  manufacturing_date       DateTime?                  @db.Date
  quantity                 Int                        @default(0)
  purchase_rate            Decimal?                   @db.Decimal(12, 2)
  mrp                      Decimal?                   @db.Decimal(12, 2)
  selling_rate             Decimal?                   @db.Decimal(12, 2)
  rack                     String?                    @db.VarChar(20)
  shelf                    String?                    @db.VarChar(20)
  bin                      String?                    @db.VarChar(20)
  supplier_id              BigInt?                    @db.UnsignedBigInt
  grn_id                   BigInt?                    @db.UnsignedBigInt
  module_instances         module_instances?          @relation(fields: [module_instance_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_pharmacy_stock_instance")
  medicines                medicines?                 @relation(fields: [medicine_id], references: [id], onUpdate: Restrict, map: "fk_pharmacy_stock_medicine")
  suppliers                suppliers?                 @relation(fields: [supplier_id], references: [id], onUpdate: Restrict, map: "fk_pharmacy_stock_supplier")
  tenants                  tenants                    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_stock_tenant")
  pharmacy_stock_movements pharmacy_stock_movements[]

  @@unique([tenant_id, module_instance_id, medicine_name, batch_number], map: "uq_pharmacy_stock_instance_batch")
  @@index([tenant_id], map: "idx_stock_hospital")
  @@index([tenant_id, medicine_name], map: "idx_stock_hospital_medicine")
  @@index([module_instance_id], map: "idx_pharmacy_stock_instance")
  @@index([supplier_id], map: "fk_pharmacy_stock_supplier")
  @@index([medicine_id], map: "idx_pharmacy_stock_medicine")
}

model pharmacy_stock_movements {
  id                   BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id            BigInt                        @db.UnsignedBigInt
  stock_id             BigInt                        @db.UnsignedBigInt
  type                 pharmacy_stock_movements_type
  quantity_delta       Int
  reason               String?                       @db.VarChar(500)
  prescription_item_id BigInt?                       @db.UnsignedBigInt
  performed_by         BigInt?                       @db.UnsignedBigInt
  created_at           DateTime                      @default(now())
  reference_type       String?                       @db.VarChar(30)
  reference_id         BigInt?                       @db.UnsignedBigInt
  prescription_items   prescription_items?           @relation(fields: [prescription_item_id], references: [id], onUpdate: Restrict, map: "fk_stock_movements_item")
  pharmacy_stock       pharmacy_stock                @relation(fields: [stock_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_stock_movements_stock")
  tenants              tenants                       @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_stock_movements_tenant")
  users                users?                        @relation(fields: [performed_by], references: [id], onUpdate: Restrict, map: "fk_stock_movements_user")

  @@index([prescription_item_id], map: "fk_stock_movements_item")
  @@index([performed_by], map: "fk_stock_movements_user")
  @@index([stock_id], map: "idx_stock_movements_stock")
  @@index([tenant_id], map: "idx_stock_movements_tenant")
  @@index([tenant_id, type], map: "idx_stock_movements_tenant_type")
}

model pharmacy_thresholds {
  id                  BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id           BigInt   @db.UnsignedBigInt
  medicine_name       String
  low_stock_threshold Int      @default(10) @db.UnsignedInt
  updated_at          DateTime @default(now())
  max_stock           Int?     @db.UnsignedInt
  tenants             tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pharmacy_thresholds_tenant")

  @@unique([tenant_id, medicine_name], map: "uq_pharmacy_thresholds")
  @@index([tenant_id], map: "idx_pharmacy_thresholds_tenant")
}

model prescription_item_acks {
  id                   BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id            BigInt             @db.UnsignedBigInt
  prescription_item_id BigInt             @db.UnsignedBigInt
  warning              String             @db.VarChar(500)
  acknowledged_by      BigInt             @db.UnsignedBigInt
  acknowledged_at      DateTime           @default(now())
  prescription_items   prescription_items @relation(fields: [prescription_item_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_presc_acks_item")
  tenants              tenants            @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_presc_acks_tenant")
  users                users              @relation(fields: [acknowledged_by], references: [id], onUpdate: Restrict, map: "fk_presc_acks_user")

  @@index([acknowledged_by], map: "fk_presc_acks_user")
  @@index([prescription_item_id], map: "idx_presc_acks_item")
  @@index([tenant_id], map: "idx_presc_acks_tenant")
}

model prescription_items {
  id                       BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id                BigInt                     @db.UnsignedBigInt
  prescription_id          BigInt                     @db.UnsignedBigInt
  medicine_name            String
  service_id               BigInt?                    @db.UnsignedBigInt
  dosage                   String?
  quantity                 Int                        @default(1) @db.UnsignedInt
  dispensed_quantity       Int                        @default(0) @db.UnsignedInt
  batch_number             String?
  status                   prescription_items_status  @default(PENDING)
  pharmacy_stock_movements pharmacy_stock_movements[]
  prescription_item_acks   prescription_item_acks[]
  prescriptions            prescriptions              @relation(fields: [prescription_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_presc_items_prescription")
  services                 services?                  @relation(fields: [service_id], references: [id], onUpdate: Restrict, map: "fk_presc_items_service")
  tenants                  tenants                    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_presc_items_tenant")

  @@index([tenant_id], map: "idx_presc_items_hospital")
  @@index([prescription_id], map: "idx_presc_items_prescription")
  @@index([service_id], map: "idx_presc_items_service")
}

model prescriptions {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id          BigInt               @db.UnsignedBigInt
  visit_id           BigInt?              @db.UnsignedBigInt
  consultation_id    BigInt               @db.UnsignedBigInt
  status             prescriptions_status @default(PENDING)
  notes              String?              @db.VarChar(500)
  created_by         BigInt?              @db.UnsignedBigInt
  created_at         DateTime             @default(now())
  fulfilled_by       BigInt?              @db.UnsignedBigInt
  fulfilled_at       DateTime?
  prescription_items prescription_items[]
  consultations      consultations        @relation(fields: [consultation_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_prescriptions_consultation")
  tenants            tenants              @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_prescriptions_tenant")
  visits             visits?              @relation(fields: [visit_id], references: [id], onUpdate: Restrict, map: "fk_prescriptions_visit")

  @@index([consultation_id], map: "idx_prescriptions_consultation")
  @@index([tenant_id], map: "idx_prescriptions_hospital")
  @@index([tenant_id, status], map: "idx_prescriptions_hospital_status")
  @@index([visit_id], map: "idx_prescriptions_visit")
}

model print_branding {
  id              BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id       BigInt               @db.UnsignedBigInt
  scope           print_branding_scope @default(TENANT)
  doctor_user_id  BigInt?              @db.UnsignedBigInt
  header_name     String
  logo_url        String?              @db.VarChar(500)
  qualifications  String?              @db.VarChar(255)
