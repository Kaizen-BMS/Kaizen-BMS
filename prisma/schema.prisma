  @@index([tenant_id], map: "idx_grn_items_tenant")
}

model grns {
  id                      BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id               BigInt           @db.UnsignedBigInt
  module_instance_id      BigInt?          @db.UnsignedBigInt
  grn_number              String           @db.VarChar(40)
  grn_date                DateTime         @db.Date
  supplier_id             BigInt?          @db.UnsignedBigInt
  supplier_invoice_number String?          @db.VarChar(80)
  supplier_invoice_date   DateTime?        @db.Date
  notes                   String?          @db.VarChar(500)
  created_by              BigInt?          @db.UnsignedBigInt
  created_at              DateTime         @default(now()) @db.DateTime(0)
  po_id                   BigInt?          @db.UnsignedBigInt
  grn_items               grn_items[]
  purchase_orders         purchase_orders? @relation(fields: [po_id], references: [id], onUpdate: Restrict, map: "fk_grns_po")
  suppliers               suppliers?       @relation(fields: [supplier_id], references: [id], onUpdate: Restrict, map: "fk_grns_supplier")
  tenants                 tenants          @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_grns_tenant")

  @@unique([tenant_id, grn_number], map: "uq_grns_tenant_number")
  @@index([supplier_id], map: "idx_grns_supplier")
  @@index([tenant_id], map: "idx_grns_tenant")
  @@index([po_id], map: "fk_grns_po")
}

model medicines {
  id                    BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id             BigInt                 @db.UnsignedBigInt
  name                  String
  generic_name          String?
  brand_name            String?
  medicine_type         String                 @default("OTHER") @db.VarChar(20)
  strength              String?                @db.VarChar(60)
  dosage_form           String?                @db.VarChar(60)
  manufacturer          String?
  composition           String?                @db.VarChar(255)
  category              String?                @db.VarChar(100)
  schedule              String?                @db.VarChar(20)
  prescription_required Boolean                @default(false)
  barcode               String?                @db.VarChar(64)
  hsn_code              String?                @db.VarChar(20)
  gst_rate              Decimal                @default(0.00) @db.Decimal(5, 2)
  pack_size             String?                @db.VarChar(60)
  unit                  String?                @db.VarChar(30)
  reorder_level         Int                    @default(10) @db.UnsignedInt
  max_stock             Int?                   @db.UnsignedInt
  rack                  String?                @db.VarChar(20)
  shelf                 String?                @db.VarChar(20)
  bin                   String?                @db.VarChar(20)
  active                Boolean                @default(true)
  created_by            BigInt?                @db.UnsignedBigInt
  updated_by            BigInt?                @db.UnsignedBigInt
  created_at            DateTime               @default(now()) @db.DateTime(0)
  updated_at            DateTime               @default(now()) @db.DateTime(0)
  grn_items             grn_items[]
  tenants               tenants                @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_medicines_tenant")
  pharmacy_stock        pharmacy_stock[]
  purchase_order_items  purchase_order_items[]

  @@index([tenant_id], map: "idx_medicines_tenant")
  @@index([tenant_id, barcode], map: "idx_medicines_tenant_barcode")
  @@index([tenant_id, name], map: "idx_medicines_tenant_name")
}

model stock_transfers {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id        BigInt   @db.UnsignedBigInt
  medicine_id      BigInt?  @db.UnsignedBigInt
  from_instance_id BigInt   @db.UnsignedBigInt
  to_instance_id   BigInt   @db.UnsignedBigInt
  from_stock_id    BigInt   @db.UnsignedBigInt
  to_stock_id      BigInt   @db.UnsignedBigInt
  batch_number     String?  @db.VarChar(80)
  quantity         Int      @db.UnsignedInt
  reason           String?  @db.VarChar(255)
  performed_by     BigInt?  @db.UnsignedBigInt
  created_at       DateTime @default(now()) @db.DateTime(0)
  tenants          tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_transfers_tenant")

  @@index([tenant_id], map: "idx_transfers_tenant")
}

model supplier_returns {
  id          BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id   BigInt                  @db.UnsignedBigInt
  stock_id    BigInt                  @db.UnsignedBigInt
  medicine_id BigInt?                 @db.UnsignedBigInt
  supplier_id BigInt?                 @db.UnsignedBigInt
  quantity    Int                     @db.UnsignedInt
  reason      supplier_returns_reason
  notes       String?                 @db.VarChar(255)
  created_by  BigInt?                 @db.UnsignedBigInt
  created_at  DateTime                @default(now()) @db.DateTime(0)
  tenants     tenants                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_supplier_returns_tenant")

  @@index([tenant_id], map: "idx_supplier_returns_tenant")
}

model suppliers {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id       BigInt            @db.UnsignedBigInt
  name            String
  company_name    String?
  contact_person  String?
  phone           String?           @db.VarChar(32)
  email           String?
  address         String?           @db.VarChar(500)
  gstin           String?           @db.VarChar(20)
  drug_licence_no String?           @db.VarChar(60)
  payment_terms   String?           @db.VarChar(100)
  credit_days     Int?              @db.UnsignedInt
  active          Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.DateTime(0)
  grns            grns[]
  pharmacy_stock  pharmacy_stock[]
  purchase_orders purchase_orders[]
  tenants         tenants           @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_suppliers_tenant")

  @@index([tenant_id], map: "idx_suppliers_tenant")
}

model purchase_order_items {
  id                BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id         BigInt          @db.UnsignedBigInt
  po_id             BigInt          @db.UnsignedBigInt
  medicine_id       BigInt          @db.UnsignedBigInt
  quantity          Int             @db.UnsignedInt
  free_quantity     Int             @default(0) @db.UnsignedInt
  purchase_rate     Decimal         @default(0.00) @db.Decimal(12, 2)
  discount_percent  Decimal         @default(0.00) @db.Decimal(5, 2)
  gst_rate          Decimal         @default(0.00) @db.Decimal(5, 2)
  notes             String?         @db.VarChar(255)
  received_quantity Int             @default(0) @db.UnsignedInt
  medicines         medicines       @relation(fields: [medicine_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_poi_medicine")
  purchase_orders   purchase_orders @relation(fields: [po_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_poi_po")
  tenants           tenants         @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_poi_tenant")

  @@index([medicine_id], map: "fk_poi_medicine")
  @@index([po_id], map: "idx_poi_po")
  @@index([tenant_id], map: "idx_poi_tenant")
}

model purchase_orders {
  id                     BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id              BigInt                 @db.UnsignedBigInt
  module_instance_id     BigInt?                @db.UnsignedBigInt
  po_number              String                 @db.VarChar(40)
  po_date                DateTime               @db.Date
  supplier_id            BigInt?                @db.UnsignedBigInt
  expected_delivery_date DateTime?              @db.Date
  status                 purchase_orders_status @default(DRAFT)
  notes                  String?                @db.VarChar(500)
  created_by             BigInt?                @db.UnsignedBigInt
  created_at             DateTime               @default(now()) @db.DateTime(0)
  updated_at             DateTime               @default(now()) @db.DateTime(0)
  grns                   grns[]
  purchase_order_items   purchase_order_items[]
  suppliers              suppliers?             @relation(fields: [supplier_id], references: [id], onUpdate: Restrict, map: "fk_po_supplier")
  tenants                tenants                @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_po_tenant")

  @@unique([tenant_id, po_number], map: "uq_po_tenant_number")
  @@index([supplier_id], map: "idx_po_supplier")
  @@index([tenant_id], map: "idx_po_tenant")
}

model vital_parameters {
  id            BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id     BigInt                      @db.UnsignedBigInt
  field_key     String                      @db.VarChar(40)
  label         String                      @db.VarChar(100)
  unit          String?                     @db.VarChar(30)
  value_type    vital_parameters_value_type @default(NUMBER)
  range_config  String?                     @db.Text
  display_order Int                         @default(0) @db.UnsignedInt
  active        Boolean                     @default(true)
  created_at    DateTime                    @default(now()) @db.DateTime(0)
  updated_at    DateTime                    @default(now()) @db.DateTime(0)
  tenants       tenants                     @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_vital_params_tenant")

  @@unique([tenant_id, field_key], map: "uq_vital_params_tenant_key")
  @@index([tenant_id], map: "idx_vital_params_tenant")
}

model wards {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id     BigInt   @db.UnsignedBigInt
  code          String   @db.VarChar(30)
  name          String   @db.VarChar(100)
  floor         String?  @db.VarChar(50)
  display_order Int      @default(0) @db.UnsignedInt
  active        Boolean  @default(true)
  created_at    DateTime @default(now()) @db.DateTime(0)
  updated_at    DateTime @default(now()) @db.DateTime(0)
  tenants       tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_wards_tenant")

  @@unique([tenant_id, code], map: "uq_wards_tenant_code")
  @@index([tenant_id], map: "idx_wards_tenant")
}

